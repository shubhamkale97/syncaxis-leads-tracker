<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Syncaxis Leads Tracker Intelligence Mechanism</title>

<!-- PWA: installable on Android/iOS/iPadOS/desktop as a home-screen app. This is the
     SAME app/file/URL, not a separate build -- every code change here reaches every
     installed device the next time it has a connection, since sw.js is deliberately
     network-first (see that file's own comment). -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#12151b">
<link rel="icon" href="icons/favicon-32.png" sizes="32x32">
<link rel="icon" href="icons/icon-192.png" sizes="192x192">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Syncaxis Leads">
<meta name="mobile-web-app-capable" content="yes">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<style>
  :root{
    --bg: #12151b;
    --panel: #1a1f28;
    --panel-2: #1f2531;
    --line: #2a313d;
    --line-soft: #232a35;
    --text: #e8ebf0;
    --text-dim: #97a1b3;
    --text-faint: #626c7d;
    --amber: #f0a63b;
    --amber-dim: #6b5327;
    --amber-fg: #f6c47f;
    --blue: #4a90d9;
    --blue-dim: #294059;
    --blue-fg: #cfe0f5;
    --green: #4cb782;
    --green-dim: #204632;
    --red: #d96a6a;
    --red-dim: #4a2b2b;
    --red-fg: #ffd9d9;
    --purple: #c9a4f0;
    --font-display: 'Space Grotesk', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  /* Light mode — clean, professional, same accent hues re-tuned for a white/light
     background (dim badge backgrounds go pale, badge text goes dark, for contrast). */
  html[data-theme="light"]{
    --bg: #f4f6f9; --panel: #ffffff; --panel-2: #eef1f6; --line: #d7dce4; --line-soft: #e4e8ee;
    --text: #171b23; --text-dim: #4d5768; --text-faint: #8993a4;
    --amber: #b8730f; --amber-dim: #fbe4bc; --amber-fg: #7a4a08;
    --blue: #1f6fb5; --blue-dim: #d9e9fa; --blue-fg: #144d80;
    --green: #1a8f5a; --green-dim: #d7f3e4;
    --red: #c23d3d; --red-dim: #f9dcdc; --red-fg: #8a2424;
    --purple: #7c4fb0;
  }
  /* Eye-protection mode — warm, low-contrast, sepia/paper tones (reduced blue light),
     similar to an e-reader's "warm" or "night light" display mode. */
  html[data-theme="eye"]{
    --bg: #f2e8d5; --panel: #faf3e4; --panel-2: #ede0c8; --line: #d8c7a3; --line-soft: #e3d4b3;
    --text: #3b2f1f; --text-dim: #6b5a3f; --text-faint: #94825f;
    --amber: #a56a1a; --amber-dim: #e8cf9c; --amber-fg: #5c3a0a;
    --blue: #4a6f8a; --blue-dim: #d8e2df; --blue-fg: #2c4a5c;
    --green: #5a7d3f; --green-dim: #e0ead0;
    --red: #a8503a; --red-dim: #ecdac8; --red-fg: #6b2f1a;
    --purple: #8a6b46;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.45;
    padding: 28px 32px 60px;
    transition: background-color .25s ease, color .25s ease;
    background-image:
      radial-gradient(circle at 15% 0%, rgba(74,144,217,0.08), transparent 40%),
      radial-gradient(circle at 90% 10%, rgba(240,166,59,0.06), transparent 35%);
  }
  .wrap{ max-width: 1320px; margin: 0 auto; }

  header{
    display:flex; justify-content:space-between; align-items:flex-end;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px; margin-bottom: 24px;
    flex-wrap: wrap; gap: 14px;
  }
  .eyebrow{
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    color: var(--amber); text-transform: uppercase; margin-bottom: 6px;
  }
  h1{ font-family: var(--font-display); font-weight: 600; font-size: 28px; letter-spacing: -0.01em; }
  .header-sub{ color: var(--text-dim); font-size: 13px; margin-top: 4px; }
  .header-right{ text-align: right; font-family: var(--font-mono); font-size: 11px; color: var(--text-faint); }
  .save-indicator{
    display:inline-flex; align-items:center; gap:6px; font-family: var(--font-mono); font-size:11px;
    color: var(--text-faint); margin-top:6px; transition: color .2s ease;
  }
  .save-indicator .dot{ width:6px; height:6px; border-radius:50%; background: var(--text-faint); transition: background .2s ease;}
  .save-indicator.saving .dot{ background: var(--amber); }
  .save-indicator.saved .dot{ background: var(--green); }
  .save-indicator.error .dot{ background: var(--red); }
  .save-indicator.live .dot{ background: var(--green); box-shadow: 0 0 0 3px rgba(76,183,130,0.18); }
  .save-indicator.offline .dot{ background: var(--red); }
  .sync-meta{ font-family: var(--font-mono); font-size:10.5px; color: var(--text-faint); margin-top:3px; }
  .user-badge{ font-family: var(--font-mono); font-size:11px; color: var(--text-dim); margin-top:8px; }
  .user-badge button{ background:none; border:none; color: var(--blue); cursor:pointer; font-family:inherit; font-size:inherit; padding:0; margin-left:8px; text-decoration:underline; }
  .edited-by{ font-size:9px; color:var(--text-faint); display:block; margin-top:1px; white-space:nowrap; }

  .mgmt-access{ margin-top:12px; display:flex; justify-content:flex-end; align-items:center; gap:8px; }
  .mgmt-access .btn{ font-size:10.5px; padding:6px 10px; }

  .notes-btn{
    display:block; width:100%; min-width:150px; max-width:220px; text-align:left; background:transparent;
    border:1px solid transparent; border-radius:5px; padding:5px 6px; color: var(--text-dim);
    font-family: var(--font-body); font-size:12px; cursor:pointer;
  }
  .notes-btn:hover{ border-color: var(--line-soft); color: var(--text); background: var(--panel-2); }
  .notes-preview-line{ display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .notes-btn .notes-count{
    display:inline-block; background: var(--blue-dim); color:var(--blue-fg); font-family: var(--font-mono); font-size:10px;
    border-radius:20px; padding:1px 6px; margin-right:6px;
  }
  .notes-next-followup{
    display:block; margin-top:3px; font-family: var(--font-mono); font-size:10.5px; color: var(--amber);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .notes-btn.empty{ color: var(--text-faint); font-style:italic; }
  .note-entry{ background: var(--panel-2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; }
  .note-entry.legacy{ border-style:dashed; opacity:0.85; }
  .note-entry-head{ display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:5px; }
  .note-date{ font-family: var(--font-mono); font-size:11px; color: var(--amber); font-weight:600; }
  .note-by{ font-family: var(--font-mono); font-size:10.5px; color: var(--text-faint); margin-left:6px; }
  .note-text{ font-size:12.5px; color: var(--text); white-space:pre-wrap; word-break:break-word; }
  .note-del{ width:20px; height:20px; font-size:10px; }
  .notes-empty-hint{ font-size:12px; color: var(--text-faint); padding:12px 0; text-align:center; }

  .followup-group-title{
    font-family: var(--font-mono); font-size:10.5px; text-transform:uppercase; letter-spacing:.04em;
    color: var(--text-faint); margin-bottom:8px;
  }
  .followup-item{
    display:flex; justify-content:space-between; align-items:center; gap:12px;
    background: var(--panel-2); border:1px solid var(--line); border-radius:8px;
    padding:10px 12px; margin-bottom:8px; cursor:pointer; transition: border-color .12s ease;
  }
  .followup-item:hover{ border-color: var(--text-faint); }
  .followup-item-main{ min-width:0; flex:1; }
  .followup-item-company{ font-size:12.5px; font-weight:600; color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .followup-item-note{ font-size:11.5px; color: var(--text-dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px; }
  .followup-item-meta{ flex:none; text-align:right; }
  .followup-item-date{ font-family: var(--font-mono); font-size:11px; color: var(--text-dim); }
  .followup-badge{ display:block; font-family: var(--font-mono); font-size:10px; margin-top:2px; white-space:nowrap; }
  .followup-badge.overdue{ color: var(--red); }
  .followup-badge.soon{ color: var(--amber); }
  @media (max-width:760px){ .followup-item{ flex-direction:column; align-items:flex-start; } .followup-item-meta{ text-align:left; } }

  .offline-banner{
    display:none; position:sticky; top:0; z-index:300; background: var(--red-dim); color:var(--red-fg);
    border-bottom:1px solid var(--red); text-align:center; font-family: var(--font-mono); font-size:12px;
    padding:9px 14px; line-height:1.4;
  }
  .offline-banner.show{ display:block; }

  /* Theme toggle — fixed top-right, out of the header's button row enterely, so it
     reads as a persistent "display setting" rather than another workflow action. */
  .theme-toggle-fixed{
    position:fixed; top:16px; right:16px; z-index:400; display:flex; gap:3px;
    background: var(--panel); border:1px solid var(--line); border-radius:11px; padding:4px;
    box-shadow: 0 6px 20px rgba(0,0,0,.28);
  }
  .theme-toggle-fixed button{
    width:30px; height:30px; display:flex; align-items:center; justify-content:center;
    border:none; background:transparent; border-radius:8px; cursor:pointer; font-size:15px; line-height:1;
    color: var(--text-faint); transition: background-color .15s ease, color .15s ease, transform .15s ease;
  }
  .theme-toggle-fixed button:hover{ background: var(--panel-2); color: var(--text); transform: translateY(-1px); }
  .theme-toggle-fixed button.active{ background: var(--blue-dim); color: var(--blue-fg); }
  @media (max-width:760px){ .theme-toggle-fixed{ top:auto; bottom:16px; right:16px; } }

  /* Toast notifications — replace jarring native alert() popups with a small
     animated stack in the corner, for anything that's a notice rather than a
     yes/no decision (those still use confirm(), which genuinely needs to block). */
  .toast-stack{ position:fixed; bottom:20px; right:20px; z-index:500; display:flex; flex-direction:column; gap:8px; align-items:flex-end; max-width:340px; }
  .toast{
    background: var(--panel); border:1px solid var(--line); border-left:3px solid var(--blue);
    color: var(--text); padding:12px 16px; border-radius:10px; font-size:12.5px; line-height:1.45;
    box-shadow: 0 10px 28px rgba(0,0,0,.32); opacity:0; transform: translateY(10px) scale(.97);
    transition: opacity .25s ease, transform .25s ease; pointer-events:auto;
  }
  .toast.show{ opacity:1; transform: translateY(0) scale(1); }
  .toast.toast-success{ border-left-color: var(--green); }
  .toast.toast-error{ border-left-color: var(--red); }

  /* Fixed 6-column grid, not auto-fit: auto-fit stretches a short last row's tiles
     wider than the row above it whenever the tile count doesn't divide evenly,
     which looked inconsistent with 12 KPI tiles wrapping as 8+4. A fixed count
     keeps every tile the same width on every row regardless of how many there are. */
  .kpi-row{ display:grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-bottom: 26px; }
  @media (max-width: 1100px){ .kpi-row{ grid-template-columns: repeat(3, 1fr); } }
  .kpi{
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    padding: 16px 16px 14px; position: relative; overflow:hidden;
  }
  .kpi::before{ content:''; position:absolute; left:0; top:0; bottom:0; width: 3px; background: var(--accent, var(--blue)); }
  .kpi-label{ font-size: 10.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;}
  .kpi-value{ font-family: var(--font-mono); font-size: 27px; font-weight: 700; color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .kpi-value.currency{ font-size: 19px; }
  .kpi-sub{ font-size: 11px; color: var(--text-faint); margin-top: 4px; }
  .inr-prefix{ color: var(--text-faint); font-family: var(--font-mono); font-size:11px; flex:none; }
  .lead-value-cell{ display:flex; align-items:center; gap:3px; }
  .lead-value-cell .cell-input{ min-width:76px; text-align:right; font-family: var(--font-mono); font-size:11.5px; }
  .enquiry-cell{ display:flex; align-items:center; gap:5px; }
  .priority-badge{ flex:none; font-size:13px; line-height:1; cursor:default; }
  /* Enquiry Number itself glows to match its priority (not just the badge) — kept
     subtle (small blur, no change to size/weight of the digits) so the number stays
     easy to read. Selectors are deliberately specific so this also wins over the
     mobile "small header" color rule for this cell. */
  table.leads .enquiry-cell.priority-hot .cell-input{ color:#ff8a5c; text-shadow:0 0 5px rgba(255,120,60,.5); }
  table.leads .enquiry-cell.priority-warm .cell-input{ color:#ffcf6b; text-shadow:0 0 5px rgba(240,166,59,.4); }
  table.leads .enquiry-cell.priority-cold .cell-input{ color:#8fd3f4; text-shadow:0 0 5px rgba(120,190,240,.4); }

  .section{
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    padding: 20px 22px 22px; margin-bottom: 20px;
  }
  .section-head{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom: 16px; flex-wrap:wrap; gap:10px;}
  .section-title{ font-family: var(--font-display); font-size: 16px; font-weight: 600; }
  .section-note{ font-size: 12px; color: var(--text-faint); }

  .chart-grid{ display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; }
  @media (max-width: 1100px){ .chart-grid{ grid-template-columns: 1fr 1fr; } }
  @media (max-width: 700px){ .chart-grid{ grid-template-columns: 1fr; } .kpi-row{ grid-template-columns: repeat(2,1fr);} }

  .bar-row{ display:grid; grid-template-columns: 108px 1fr 32px; align-items:center; gap:8px; margin-bottom: 9px; }
  .bar-label{ font-size: 11.5px; color: var(--text-dim); text-align:right; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .bar-track{ background: var(--line-soft); border-radius: 4px; height: 15px; overflow:hidden; }
  .bar-fill{ height:100%; border-radius:4px; transition: width .5s ease; }
  .bar-val{ font-family: var(--font-mono); font-size: 11.5px; color: var(--text-dim); }

  .matrix-toggle{ display:flex; gap:6px; background:var(--panel-2); border:1px solid var(--line); border-radius:8px; padding:3px; }
  .matrix-toggle button{
    font-family: var(--font-mono); font-size: 11px; padding:5px 10px; border-radius:6px; border:none;
    background:transparent; color:var(--text-faint); cursor:pointer; letter-spacing:0.03em;
  }
  .matrix-toggle button.active{ background: var(--blue-dim); color: var(--blue-fg); }
  .matrix-scroll{ overflow-x:auto; border:1px solid var(--line); border-radius:8px; }
  table.matrix{ border-collapse: collapse; width:100%; font-size: 11.5px; }
  table.matrix th, table.matrix td{ padding: 7px 8px; text-align:center; border: 1px solid var(--line-soft); white-space:nowrap; }
  table.matrix th{ background: var(--panel-2); font-family: var(--font-mono); font-weight:500; color:var(--text-dim); font-size:10.5px; }
  table.matrix th.rowhead, table.matrix td.rowhead{ text-align:left; position:sticky; left:0; background: var(--panel-2); color: var(--text); font-weight:600; z-index:2; }
  table.matrix td.cell{ font-family: var(--font-mono); cursor:pointer; color: var(--text-dim); }
  table.matrix td.cell:hover{ outline: 1px solid var(--amber); outline-offset:-1px; }
  table.matrix td.cell.zero{ color: var(--text-faint); }
  table.matrix td.total, table.matrix th.total{ font-weight:700; color: var(--amber); background: rgba(240,166,59,0.06); }

  .insight{
    background: var(--panel-2); border:1px solid var(--line); border-left: 3px solid var(--amber);
    border-radius: 8px; padding: 12px 16px; font-size: 12.5px; color: var(--text-dim); margin-top: 14px;
  }
  .insight b{ color: var(--text); }

  .filter-bar{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .filter-bar select, .filter-bar input{
    background: var(--panel-2); border:1px solid var(--line); color: var(--text);
    font-family: var(--font-body); font-size:12.5px; padding:7px 10px; border-radius:7px; outline:none;
  }
  .filter-bar input{ min-width:190px; }
  .filter-bar select:focus, .filter-bar input:focus{ border-color: var(--blue); }
  .btn{
    font-family: var(--font-mono); font-size:11px; letter-spacing:.02em; cursor:pointer;
    border-radius: 7px; padding: 7px 12px; border:1px solid var(--line); background:none; color: var(--text-dim);
    transition: color .15s ease, border-color .15s ease, background-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{ color: var(--text); border-color: var(--text-faint); transform: translateY(-1px); box-shadow: 0 3px 10px rgba(0,0,0,.18); }
  .btn:active{ transform: translateY(0); box-shadow:none; }
  .btn-primary{ background: var(--amber-dim); border-color: var(--amber-dim); color: var(--amber-fg); }
  .btn-primary:hover{ color: #fff; border-color: var(--amber); }

  .table-scroll{ overflow-x:auto; margin-top:14px; border:1px solid var(--line); border-radius:8px; max-height: 560px; overflow-y:auto;}
  table.leads{ border-collapse:collapse; width:100%; font-size:12px; min-width: 1500px; }
  table.leads th{
    position:sticky; top:0; background: var(--panel-2); text-align:left; padding:9px 8px;
    font-family: var(--font-mono); font-size:10px; color: var(--text-dim); text-transform:uppercase; letter-spacing:.04em;
    border-bottom:1px solid var(--line); z-index: 1; white-space:nowrap;
  }
  table.leads td{ padding:5px 8px; border-bottom:1px solid var(--line-soft); color: var(--text-dim); vertical-align:middle; }
  table.leads tr:hover td{ background: rgba(255,255,255,0.02); }
  /* Pin the Edit column to the right edge on desktop. The table is ~30 columns wide,
     so an edit affordance that only appears after scrolling all the way right is
     effectively invisible from where the mistake is actually spotted. Scoped above
     the mobile breakpoint, where the table becomes stacked cards and sticky makes no
     sense. Opaque background so the scrolling cells pass underneath it, not through. */
  @media (min-width:761px){
    table.leads th:last-child, table.leads td:last-child{
      position:sticky; right:0; z-index:2;
      background: var(--panel); border-left:1px solid var(--line);
    }
    table.leads thead th:last-child{ background: var(--panel-2); z-index:3; }
    table.leads tr:hover td:last-child{ background: var(--panel-2); }
  }
  tr.new-row td{ background: rgba(76,183,130,0.05); }

  .cell-input{
    width:100%; background:transparent; border:1px solid transparent; color: var(--text);
    font-family: var(--font-body); font-size:12px; padding:5px 6px; border-radius:5px; outline:none;
  }
  .cell-input:hover{ border-color: var(--line-soft); }
  .cell-input:focus{ border-color: var(--blue); background: var(--panel-2); }
  select.cell-input{ cursor:pointer; }
  input.cell-input[type="email"], input.cell-input[type="tel"]{ font-family: var(--font-mono); font-size:11.5px; }

  /* ============ Mobile ============
     Below 760px the leads table becomes a stacked list of cards — same DOM,
     same inputs, same wiring, just a different visual layout via CSS (each
     <td> already carries a data-label attribute for its ::before label). */
  @media (max-width: 760px){
    body{ padding: 14px 12px 40px; }
    header{ flex-direction:column; align-items:flex-start; gap:10px; }
    .header-right{ text-align:left; width:100%; }
    .mgmt-access{ justify-content:flex-start; margin-top:10px; }
    h1{ font-size:21px; }
    .eyebrow{ font-size:10px; }

    .kpi-row{ grid-template-columns: repeat(2, 1fr); gap:8px; margin-bottom:16px; }
    .kpi{ padding:11px 12px 9px; }
    .kpi-value{ font-size:19px; }
    .kpi-value.currency{ font-size:15px; }

    .section{ padding:14px 14px 16px; }
    .chart-grid{ grid-template-columns: 1fr; gap:20px; }
    .report-chart-row{ grid-template-columns: 1fr; }

    .filter-bar{ flex-direction:column; align-items:stretch; }
    .filter-bar input, .filter-bar select{ width:100%; min-width:0; }
    .filter-bar .btn{ width:100%; }

    .form-grid{ grid-template-columns: 1fr !important; }
    .modal{ padding:18px 16px; max-height:90vh; }

    .matrix-scroll{ font-size:11px; }

    .icon-btn{ width:32px; height:32px; font-size:14px; }
    .mgmt-toolbar{ flex-direction:column; align-items:flex-start; gap:10px; padding-right:24px; } /* toggle moves to bottom-right on mobile, so no need to reserve space up top here */
    .report-toolbar{ flex-wrap:wrap; }

    /* Leads table → cards */
    .table-scroll{ overflow-x:visible; max-height:none; border:none; }
    table.leads{ min-width:0; width:100%; }
    table.leads thead{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
    table.leads, table.leads tbody{ display:block; width:100%; }
    table.leads tr{
      display:block; background: var(--panel); border:1px solid var(--line); border-radius:10px;
      margin-bottom:12px; padding:4px 12px 8px;
    }
    table.leads td{
      display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--line-soft);
      text-align:right;
    }
    table.leads td:last-child{ border-bottom:none; }
    table.leads td::before{
      content: attr(data-label); flex:none; width:38%; text-align:left;
      font-family: var(--font-mono); font-size:9.5px; color: var(--text-faint); text-transform:uppercase; letter-spacing:.03em;
    }
    table.leads td > *{ flex:1; min-width:0; }
